---
import Base from "../layouts/Base.astro";
import Banner from "../components/Banner.astro";
import Separator from "../components/Separator.astro";
import EditionWall from "../components/EditionWall.astro";
import { getEditions, getArchive, getSite } from "../lib/editions";
import { season, strip, action, previewNow, longDate, hours, withArticle } from "../lib/season";
import { stripHtml } from "../lib/strip";
import { u } from "../lib/url";

const e = (await getEditions())[0];
const archive = await getArchive();
const d = e.data;
const site = await getSite();
const s = season(d);
const act = action(d, s, site.membership_url);
const band = strip(d, s);
// What the browser needs to recompute the state later; the build-time one can be hours old.
const data = {
  year: d.year, event_date: d.event_date, event_start: d.event_start, registration_closes_time: d.registration_closes_time, registration_opens: d.registration_opens, registration_closes: d.registration_closes,
  registration_url: d.registration_url, where: d.where, documents: d.documents.map(({ kind }) => ({ kind })), membership: site.membership_url,
};
const yy = d.year.slice(2);
const showJoin = s !== "done";
const art = d.art;
const logos = [...d.logos, ...site.logos];
---

<Base
  title={`prePLANCKS ${yy}, preselezioni italiane per PLANCKS ${d.year}`}
  description={`Preselezioni italiane per PLANCKS ${d.year}, la gara di problem solving di fisica di AISF: informazioni, iscrizione e archivio delle edizioni.`}
  theme={d.theme}
  overNav
>
  <main>
    <section class="hero" data-season={s} data-now={previewNow}>
      <Banner desktop={art?.background} mobile={art?.background_mobile} loading="eager" />
      <div class="container">
        {logos.length > 0 && (
          <ul class="hero-logos">
            {logos.map((l) => (
              <li>
                {l.href ? <a href={l.href}><img src={u(l.image)} alt={l.name} /></a> : <img src={u(l.image)} alt={l.name} />}
              </li>
            ))}
          </ul>
        )}
        <h1>prePLANCKS<br />{yy}</h1>
        {d.hero_line && <p>{d.hero_line}</p>}
        <div class="actions">
          <a class="btn btn-primary" data-action href={u(act.href)}>{act.label}</a>
          <a class="btn btn-ghost" href={u("/edizioni/")}>Tutte le edizioni</a>
        </div>
      </div>
      <div class="strip" hidden={!band} set:html={stripHtml(band)} />
    </section>

    {(art?.banner || d.who || d.event_date || d.where) && (
    <section class="showcase">
      <div class:list={["container", { "no-banner": !art?.banner }]}>
        <Banner class="banner" desktop={art?.banner} alt={art?.alt ?? `Banner di prePLANCKS ${d.year}`} />
        <dl>
          {d.who && <div><dt>Chi</dt><dd>{d.who}{d.who_detail && <small>{d.who_detail}</small>}</dd></div>}
          {d.event_date && <div><dt>Quando</dt><dd>{longDate(d.event_date)}{hours(d) && <small>{hours(d)}</small>}</dd></div>}
          {d.where && <div><dt>Dove</dt><dd>{d.where}</dd></div>}
        </dl>
      </div>
    </section>
    )}

    <section class="about" id="plancks">
      <Separator src={art?.separator} />
      <div class="container">
        <h2>{d.host ? `Una gara di problem solving di fisica, poi ${d.host}` : "Una gara di problem solving di fisica"}</h2>
        <div>
          <p>{site.plancks_intro}</p>
          <p>{site.preselection_intro}</p>
          {d.host_url && <p style="margin-top: var(--space-lg)"><a class="link" href={d.host_url}>Il sito di PLANCKS a {d.host ?? d.year}</a></p>}
        </div>
      </div>
    </section>

    <section class="join" id="iscrizione" data-join hidden={!showJoin}>
      <Separator src={art?.separator} />
        <div class="container">
          <h2>Come iscrivere una squadra</h2>
          <div>
            <ol>
              {d.registration_closes && <li><span>Le iscrizioni terminano {withArticle(d.registration_closes)}{d.registration_closes_time && ` alle ${d.registration_closes_time}`}.</span></li>}
              <li><span>Tutti i membri della squadra devono essere iscritti ad AISF.</span></li>
              {d.registration_url && <li><span>Per iscrivere la tua squadra basta compilare il form.</span></li>}
            </ol>
            <div class="actions" style="margin-top: var(--space-xl)">
              {d.registration_url && <a class="btn btn-primary" data-form hidden={s !== "open"} href={d.registration_url}>Iscrivi la squadra</a>}
              <a class:list={["btn", s === "open" && d.registration_url ? "btn-ghost" : "btn-primary"]} data-aisf href={site.membership_url}>Iscriviti ad AISF</a>
            </div>
          </div>
        </div>
      </section>

    <section class="wall" id="edizioni">
      <Separator src={art?.separator} />
      <div class="container">
        <header>
          <h2>Le edizioni precedenti</h2>
          <p style="color: var(--color-ink-2); max-width: 40ch">{site.archive_intro}</p>
        </header>
        <EditionWall editions={archive} posters={4} />
        <p style="margin-top: var(--space-xl)"><a class="link" href={u("/edizioni/")}>Tutte le edizioni dal {archive.at(-1)!.data.year}</a></p>
      </div>
    </section>

    <section class="contacts" id="contatti">
      <Separator src={art?.separator} />
      <div class="container">
        <h2>Contatti</h2>
        <ul>
          <li><span>E-mail</span><a class="link" href={`mailto:${site.email}`} style="justify-self: start">{site.email}</a></li>
          {site.socials.map((x) => <li><span>{x.name}</span><a class="link" href={x.url} style="justify-self: start">{x.label}</a></li>)}
        </ul>
      </div>
    </section>
  </main>
<script type="application/json" id="edition-data" set:html={JSON.stringify(data)} />
<script>
  import { season, strip, action } from "../lib/season";
  import { stripHtml } from "../lib/strip";
  import { u } from "../lib/url";

  const hero = document.querySelector<HTMLElement>(".hero")!;
  const data = JSON.parse(document.getElementById("edition-data")!.textContent!);
  const skew = hero.dataset.now ? Date.parse(hero.dataset.now) - Date.now() : 0; // PREVIEW_DATE only
  const now = () => Date.now() + skew;

  // The page can be older than the calendar: recompute the state now and fix what changed.
  const s = season(data, new Date(now()));
  if (s !== hero.dataset.season) {
    const act = action(data, s, data.membership);
    const button = hero.querySelector<HTMLAnchorElement>("[data-action]")!;
    button.textContent = act.label;
    button.href = u(act.href);
    const band = strip(data, s, now());
    const el = hero.querySelector<HTMLElement>(".strip")!;
    el.hidden = !band;
    el.innerHTML = stripHtml(band);
    document.querySelectorAll<HTMLElement>("[data-join]").forEach((x) => (x.hidden = s === "done"));
    document.querySelector<HTMLElement>("[data-form]")?.toggleAttribute("hidden", s !== "open");
    document.querySelector("[data-aisf]")!.className = `btn ${s === "open" && data.registration_url ? "btn-ghost" : "btn-primary"}`;
  }

  // Separators grow in when they reach the screen (the CSS hides them only when scripting is on).
  const io = new IntersectionObserver((es) => es.forEach((x) => x.isIntersecting && (x.target.classList.add("in"), io.unobserve(x.target))), { threshold: 0.6 });
  document.querySelectorAll(".sep").forEach((x) => io.observe(x));

  // Hours to seconds need the script; without it the band shows the days computed at build.
  const pad = (n: number) => String(n).padStart(2, "0");
  document.querySelectorAll<HTMLElement>("[data-to]").forEach((c) => {
    const to = Date.parse(c.dataset.to!);
    c.querySelectorAll<HTMLElement>("[hidden]").forEach((x) => (x.hidden = false));
    const set = (k: string, v: string | number) => (c.querySelector(`[data-${k}]`)!.textContent = String(v));
    const tick = () => {
      const ms = Math.max(0, to - now());
      set("d", Math.floor(ms / 864e5));
      set("h", pad(Math.floor(ms / 36e5) % 24));
      set("m", pad(Math.floor(ms / 6e4) % 60));
      set("s", pad(Math.floor(ms / 1e3) % 60));
      c.querySelectorAll<HTMLElement>("small").forEach((u) => (u.textContent = Number(u.previousElementSibling!.textContent) === 1 ? u.dataset.one! : u.dataset.n!));
    };
    tick();
    setInterval(tick, 1000);
  });
</script>
</Base>
